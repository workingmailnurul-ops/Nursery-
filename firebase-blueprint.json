{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Registered administrator accounts",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 128 },
        "role": { "type": "string", "enum": ["admin"] },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "Product": {
      "title": "Product",
      "description": "Nursery saplings and plant products",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "slug": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "scientificName": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "inStock": { "type": "boolean" },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "isTrending": { "type": "boolean" },
        "isFeatured": { "type": "boolean" },
        "isBestSeller": { "type": "boolean" }
      },
      "required": ["id", "name", "price", "category"]
    },
    "Category": {
      "title": "Category",
      "description": "Plant and accessory categories",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "slug": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "description": { "type": "string" },
        "image": { "type": "string" }
      },
      "required": ["id", "slug", "name"]
    },
    "BlogPost": {
      "title": "BlogPost",
      "description": "Gardening articles and guides",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "slug": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "excerpt": { "type": "string" },
        "content": { "type": "string" },
        "author": { "type": "string" },
        "date": { "type": "string" },
        "category": { "type": "string" },
        "image": { "type": "string" }
      },
      "required": ["id", "slug", "title", "content"]
    },
    "Article": {
      "title": "Article",
      "description": "Nursery knowledge base and care articles",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "slug": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "excerpt": { "type": "string" },
        "content": { "type": "string" },
        "author": { "type": "string" },
        "date": { "type": "string" },
        "category": { "type": "string" },
        "image": { "type": "string" }
      },
      "required": ["id", "slug", "title"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Promotional discount codes",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "maxLength": 50 },
        "discountPercent": { "type": "number" },
        "description": { "type": "string" },
        "validTill": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "code", "discountPercent"]
    },
    "Order": {
      "title": "Order",
      "description": "Store customer orders",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "maxLength": 64 },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["orderId", "total", "status"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Collection of administrators"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Collection of products"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Collection of categories"
    },
    "/blogs/{blogId}": {
      "schema": { "$ref": "#/entities/BlogPost" },
      "description": "Collection of blog posts"
    },
    "/articles/{articleId}": {
      "schema": { "$ref": "#/entities/Article" },
      "description": "Collection of articles"
    },
    "/coupons/{couponId}": {
      "schema": { "$ref": "#/entities/Coupon" },
      "description": "Collection of promotional coupons"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Collection of orders"
    }
  }
}
